-- ==================== INTRO NEMESIS (avec icône) ====================
do
    local _Players = game:GetService("Players")
    local _lp = _Players.LocalPlayer
    local _pg = _lp:FindFirstChildOfClass("PlayerGui") or _lp:WaitForChild("PlayerGui", 5)
    if not _pg then
        _pg = game:GetService("CoreGui")
    end

    local _gui = Instance.new("ScreenGui")
    _gui.Name = "_NemesisIntro"
    _gui.ResetOnSpawn = false
    _gui.IgnoreGuiInset = true
    _gui.DisplayOrder = 999999
    _gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() _gui.Parent = _pg end)

    -- Icône en grand au-dessus des textes
    local _icon = Instance.new("ImageLabel")
    _icon.Size = UDim2.new(0, 180, 0, 180)
    _icon.Position = UDim2.new(0.5, -90, 0.5, -190)
    _icon.BackgroundTransparency = 1
    _icon.BorderSizePixel = 0
    _icon.Image = "rbxassetid://72144402917648"
    _icon.ImageTransparency = 0
    _icon.ScaleType = Enum.ScaleType.Fit
    _icon.ZIndex = 2
    _icon.Parent = _gui

    local function _fadeOut(_obj)
        local _steps = 40
        for _i = 1, _steps do
            local _t = _i / _steps
            _obj.ImageTransparency = _t
            task.wait(1.4 / _steps)
        end
    end

    local function _showText(_txt, _hold, _fade)
        local _lbl = Instance.new("TextLabel")
        _lbl.Size = UDim2.new(1, 0, 0, 80)
        _lbl.Position = UDim2.new(0, 0, 0.5, -20)
        _lbl.BackgroundTransparency = 1
        _lbl.BorderSizePixel = 0
        _lbl.Font = Enum.Font.SourceSans
        _lbl.TextSize = 30
        _lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        _lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        _lbl.TextStrokeTransparency = 0
        _lbl.TextTransparency = 0
        _lbl.TextWrapped = true
        _lbl.Text = _txt
        _lbl.ZIndex = 3
        _lbl.Parent = _gui

        task.wait(_hold)

        local _steps = 40
        for _i = 1, _steps do
            local _t = _i / _steps
            _lbl.TextTransparency = _t
            _lbl.TextStrokeTransparency = _t
            task.wait((_fade or 1) / _steps)
        end
        _lbl:Destroy()
    end

    _showText("ce script a etais baiser par nemesis et personne d'autre", 2.2, 1.4)
    task.wait(0.35)
    _showText("amusez vous bien avec ce script de merde !", 2.2, 1.4)
    task.wait(0.2)

    -- Fade out de l'icône à la fin (optionnel, garde la cohérence visuelle)
    _fadeOut(_icon)

    pcall(function() _gui:Destroy() end)
end
